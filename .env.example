# PostgreSQL connection string used by the application at runtime.
# Neon/PgBouncer users: this should be the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Direct (non-pooled) PostgreSQL connection string, used only for running
# migrations (Prisma Migrate requires session-level features that connection
# poolers such as PgBouncer/Neon pooler do not support). If your database
# does not sit behind a pooler, this can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Long random secret used to derive session-token hashes. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Used once by `npm run db:seed` to create the initial Super Admin if one
# does not already exist. Change the password immediately after first login.
SEED_SUPER_ADMIN_NAME="Excell Super Admin"
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMeImmediately123!"

# 32-byte key (base64) used to encrypt sensitive HR fields (bank account
# numbers, national ID / passport numbers) at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY="replace-with-a-base64-32-byte-key"

# Optional: S3-compatible object storage for employee documents. If any of
# these are left unset, document upload/download stays disabled and the UI
# clearly shows "storage not configured" instead of a broken upload flow.
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant root. Every business-data model carries a companyId scoping its
/// rows to exactly one Company — see lib/db.ts's Prisma Client Extension,
/// which auto-injects this filter on every query so individual service
/// functions never need to remember to scope by tenant themselves.
/// Deactivating a company (not deleting — see PlatformAdmin control panel)
/// blocks login and invalidates live sessions immediately.
///
/// Every `companyId` column below is `@default("")` even though it's
/// NOT NULL and always meaningfully populated. This is a deliberate
/// TypeScript-only escape hatch: without a default, Prisma's generated
/// `XCreateInput` types would require every service-layer `.create(...)`
/// call to pass `companyId` explicitly — reintroducing exactly the
/// "every call site must remember the tenant" problem the extension
/// exists to eliminate. The extension's `scopeArgs` unconditionally
/// overwrites `data.companyId` on every create that goes through `db`,
/// so this default is never actually persisted in practice; it only
/// exists to make the field optional at the type level. A stray
/// `rawDb.<model>.create()` call that omits companyId would insert `""`
/// and fail loudly on the FK constraint, not leak data silently.
model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                         User[]
  roles                         Role[]
  permissions                   Permission[]
  rolePermissions               RolePermission[]
  sessions                      Session[]
  auditLogs                     AuditLog[]
  passwordResetTokens           PasswordResetToken[]
  departments                   Department[]
  designations                  Designation[]
  designationRequiredDocuments  DesignationRequiredDocument[]
  employmentGrades              EmploymentGrade[]
  employmentTypes               EmploymentType[]
  projectRoles                  ProjectRole[]
  documentTypes                 DocumentType[]
  certificationTypes            CertificationType[]
  employeeNumberSequence        EmployeeNumberSequence?
  employees                     Employee[]
  employeeAddresses             EmployeeAddress[]
  emergencyContacts             EmergencyContact[]
  employeeBankAccounts          EmployeeBankAccount[]
  employeeStatusHistories       EmployeeStatusHistory[]
  salaryStructures              SalaryStructure[]
  compensationComponents        CompensationComponent[]
  payrollPeriods                PayrollPeriod[]
  payslips                      Payslip[]
  payslipLineItems              PayslipLineItem[]
  cpfContributionRates          CpfContributionRate[]
  projects                      Project[]
  sites                         Site[]
  siteStageChecklistItems       SiteStageChecklistItem[]
  siteStageHistories            SiteStageHistory[]
  projectResourceRequests       ProjectResourceRequest[]
  tasks                         Task[]
  employeeProjectAssignments    EmployeeProjectAssignment[]
  employeeAvailabilityOverrides EmployeeAvailabilityOverride[]
  employeeDocuments             EmployeeDocument[]
  workPasses                    WorkPass[]
  employeeCertifications        EmployeeCertification[]
  shiftTypes                    ShiftType[]
  holidays                      Holiday[]
  attendanceRecords             AttendanceRecord[]
  leaveTypes                    LeaveType[]
  leaveBalances                 LeaveBalance[]
  leaveRequests                 LeaveRequest[]
  approvalRequests              ApprovalRequest[]
  approvalSteps                 ApprovalStep[]
  notifications                 Notification[]
  leads                         Lead[]
  tenders                       Tender[]
  quotations                    Quotation[]
  pricingLines                  PricingLine[]
  projectDocuments              ProjectDocument[]
  projectBudgetLines            ProjectBudgetLine[]
  progressClaims                ProgressClaim[]
  defectItems                   DefectItem[]
  materialCategories            MaterialCategory[]
  materials                     Material[]
  suppliers                     Supplier[]
  warehouses                    Warehouse[]
  stockLevels                   StockLevel[]
  stockTransactions             StockTransaction[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderLines            PurchaseOrderLine[]
  goodsReceipts                 GoodsReceipt[]
  goodsReceiptLines             GoodsReceiptLine[]
  supplierDocuments             SupplierDocument[]
  stockTransfers                StockTransfer[]

  @@map("companies")
}

/// Platform-level operator account — sits above every Company, never
/// tenant-scoped, never subject to the Prisma tenant-scoping extension.
/// Manages company creation/activation via the /platform-admin control
/// panel. Deliberately a separate table/auth-stack from User, not a role
/// on UserRole — see lib/auth/platform-admin-guards.ts.
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions PlatformAdminSession[]

  @@map("platform_admins")
}

model PlatformAdminSession {
  id              String   @id @default(uuid())
  platformAdminId String   @map("platform_admin_id")
  tokenHash       String   @unique @map("token_hash")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@map("platform_admin_sessions")
}

/// Application user. Role is enum-safe at the TypeScript layer via UserRole
/// (see lib/authorization/roles.ts); Role.code enforces uniqueness in the DB.
model User {
  id                 String    @id @default(uuid())
  companyId          String    @default("") @map("company_id")
  name               String
  email              String
  passwordHash       String    @map("password_hash")
  roleId             String    @map("role_id")
  role               Role      @relation(fields: [roleId], references: [id])
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  version            Int       @default(1)

  sessions            Session[]
  auditLogs           AuditLog[]           @relation("AuditLogUser")
  employee            Employee?
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  companyId    String   @default("") @map("company_id")
  code         String
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  code        String
  module      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  companyId    String   @default("") @map("company_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  allowed      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  companyId String   @default("") @map("company_id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

/// Single-use, time-limited password reset token. Mirrors Session.tokenHash:
/// only the hash is ever persisted. Domain model only in this phase — no
/// public /login/forgot-password UI is wired up because no email provider
/// is configured yet (see README limitations).
model PasswordResetToken {
  id        String    @id @default(uuid())
  companyId String    @default("") @map("company_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// HRMS — HR master data
// ---------------------------------------------------------------------------

model Department {
  id                 String   @id @default(uuid())
  companyId          String   @default("") @map("company_id")
  code               String
  name               String
  description        String?
  parentDepartmentId String?  @map("parent_department_id")
  managerEmployeeId  String?  @map("manager_employee_id")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by")
  updatedBy          String?  @map("updated_by")

  parentDepartment Department?   @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments Department[]  @relation("DepartmentHierarchy")
  managerEmployee  Employee?     @relation("DepartmentManager", fields: [managerEmployeeId], references: [id])
  employees        Employee[]    @relation("EmployeeDepartment")
  designations     Designation[]
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("departments")
}

model Designation {
  id           String   @id @default(uuid())
  companyId    String   @default("") @map("company_id")
  code         String
  name         String
  description  String?
  gradeId      String?  @map("grade_id")
  departmentId String?  @map("department_id")
  isManagerial Boolean  @default(false) @map("is_managerial")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  grade      EmploymentGrade? @relation(fields: [gradeId], references: [id])
  department Department?      @relation(fields: [departmentId], references: [id])
  employees  Employee[]       @relation("EmployeeDesignation")

  requiredDocuments DesignationRequiredDocument[]
  company           Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("designations")
}

/// Which DocumentTypes a Designation requires (e.g. "Foreman" requires a
/// Safety Certificate + Work Permit). Drives the missing-documents
/// checklist on an employee's profile — not a hard upload gate.
model DesignationRequiredDocument {
  id             String   @id @default(uuid())
  companyId      String   @default("") @map("company_id")
  designationId  String   @map("designation_id")
  documentTypeId String   @map("document_type_id")
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")

  designation  Designation  @relation(fields: [designationId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([designationId, documentTypeId])
  @@map("designation_required_documents")
}

model EmploymentGrade {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  code        String
  name        String
  rank        Int
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  designations Designation[]
  employees    Employee[]    @relation("EmployeeGrade")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("employment_grades")
}

model EmploymentType {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees Employee[] @relation("EmployeeEmploymentType")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("employment_types")
}

model ProjectRole {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments EmployeeProjectAssignment[]
  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("project_roles")
}

model DocumentType {
  id                   String   @id @default(uuid())
  companyId            String   @default("") @map("company_id")
  code                 String
  name                 String
  /// DocumentTypeScope[] (EMPLOYEE | PROJECT | SUPPLIER) — which upload
  /// surfaces this type may be selected from. See lib/hr/constants.ts.
  /// Defaults empty only to let the migration land on existing rows; the
  /// seed script's upsert immediately backfills real values afterward, and
  /// every write path (create/update form) requires at least one entry.
  appliesTo            String[] @default([]) @map("applies_to")
  requiresExpiryDate   Boolean  @default(false) @map("requires_expiry_date")
  isConfidential       Boolean  @default(false) @map("is_confidential")
  allowedMimeTypes     String[] @map("allowed_mime_types")
  maximumFileSizeBytes Int      @map("maximum_file_size_bytes")
  retentionCategory    String?  @map("retention_category")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  documents              EmployeeDocument[]
  requiredByDesignations DesignationRequiredDocument[]
  supplierDocuments      SupplierDocument[]
  projectDocuments       ProjectDocument[]
  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("document_types")
}

model CertificationType {
  id                    String   @id @default(uuid())
  companyId             String   @default("") @map("company_id")
  code                  String
  name                  String
  issuingAuthority      String?  @map("issuing_authority")
  requiresExpiryDate    Boolean  @default(true) @map("requires_expiry_date")
  defaultValidityMonths Int?     @map("default_validity_months")
  reminderDays          Int[]    @map("reminder_days")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  certifications EmployeeCertification[]
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("certification_types")
}

/// Single-row counter driving EXL-EMP-##### employee numbers. Updated inside
/// the creating transaction via SELECT ... FOR UPDATE — never count()+1.
/**
 * One counter row per company — companyId IS the primary key (not a
 * separate `id`), since each company needs its own independent employee
 * numbering sequence starting from zero, not a shared global counter.
 */
model EmployeeNumberSequence {
  companyId  String  @id @map("company_id")
  lastNumber Int     @default(0) @map("last_number")
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("employee_number_sequence")
}

// ---------------------------------------------------------------------------
// HRMS — Employee master
// ---------------------------------------------------------------------------

model Employee {
  id             String  @id @default(uuid())
  companyId      String  @default("") @map("company_id")
  employeeNumber String  @map("employee_number")
  userId         String? @unique @map("user_id")

  firstName     String  @map("first_name")
  middleName    String? @map("middle_name")
  lastName      String? @map("last_name")
  preferredName String? @map("preferred_name")

  dateOfBirth     DateTime? @map("date_of_birth")
  gender          String?
  nationalityCode String?   @map("nationality_code")
  maritalStatus   String?   @map("marital_status")

  nationalIdCiphertext String? @map("national_id_ciphertext")
  nationalIdLast4      String? @map("national_id_last4")
  passportCiphertext   String? @map("passport_ciphertext")
  passportLast4        String? @map("passport_last4")

  personalEmail         String? @map("personal_email")
  workEmail             String? @map("work_email")
  mobileNumber          String? @map("mobile_number")
  alternateMobileNumber String? @map("alternate_mobile_number")

  joiningDate      DateTime  @map("joining_date")
  confirmationDate DateTime? @map("confirmation_date")
  terminationDate  DateTime? @map("termination_date")
  lastWorkingDate  DateTime? @map("last_working_date")

  employmentStatus String @default("DRAFT") @map("employment_status")

  departmentId           String  @map("department_id")
  designationId          String  @map("designation_id")
  gradeId                String? @map("grade_id")
  employmentTypeId       String  @map("employment_type_id")
  reportingManagerId     String? @map("reporting_manager_id")
  defaultProjectId       String? @map("default_project_id")
  defaultSiteId          String? @map("default_site_id")
  defaultShiftTypeId     String? @map("default_shift_type_id")
  profilePhotoDocumentId String? @map("profile_photo_document_id")
  workLocation           String? @map("work_location") // WorkLocation: OFFICE | SITE

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  user             User?            @relation(fields: [userId], references: [id])
  department       Department       @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  designation      Designation      @relation("EmployeeDesignation", fields: [designationId], references: [id], onDelete: Restrict)
  grade            EmploymentGrade? @relation("EmployeeGrade", fields: [gradeId], references: [id])
  employmentType   EmploymentType   @relation("EmployeeEmploymentType", fields: [employmentTypeId], references: [id], onDelete: Restrict)
  reportingManager Employee?        @relation("EmployeeHierarchy", fields: [reportingManagerId], references: [id])
  directReports    Employee[]       @relation("EmployeeHierarchy")
  defaultProject   Project?         @relation("EmployeeDefaultProject", fields: [defaultProjectId], references: [id])
  defaultSite      Site?            @relation("EmployeeDefaultSite", fields: [defaultSiteId], references: [id])
  defaultShift     ShiftType?       @relation("EmployeeDefaultShift", fields: [defaultShiftTypeId], references: [id])

  managedDepartments    Department[]                   @relation("DepartmentManager")
  addresses             EmployeeAddress[]
  emergencyContacts     EmergencyContact[]
  bankAccounts          EmployeeBankAccount[]
  statusHistory         EmployeeStatusHistory[]
  documents             EmployeeDocument[]
  workPasses            WorkPass[]
  certifications        EmployeeCertification[]
  projectAssignments    EmployeeProjectAssignment[]    @relation("AssignmentEmployee")
  availabilityOverrides EmployeeAvailabilityOverride[]
  attendanceRecords     AttendanceRecord[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  assignedTasks         Task[]                         @relation("TaskAssignee")
  salaryStructure       SalaryStructure?
  payslips              Payslip[]
  managedWarehouses     Warehouse[]                    @relation("WarehouseManager")
  company               Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeNumber])
  @@unique([companyId, workEmail])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@map("employees")
}

model EmployeeAddress {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  employeeId  String   @map("employee_id")
  type        String
  line1       String
  line2       String?
  city        String?
  state       String?
  postalCode  String?  @map("postal_code")
  countryCode String?  @map("country_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, type])
  @@map("employee_addresses")
}

model EmergencyContact {
  id             String   @id @default(uuid())
  companyId      String   @default("") @map("company_id")
  employeeId     String   @map("employee_id")
  name           String
  relationship   String
  phone          String
  alternatePhone String?  @map("alternate_phone")
  email          String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("emergency_contacts")
}

model EmployeeBankAccount {
  id                      String    @id @default(uuid())
  companyId               String    @default("") @map("company_id")
  employeeId              String    @map("employee_id")
  bankName                String    @map("bank_name")
  accountHolderName       String    @map("account_holder_name")
  accountNumberCiphertext String    @map("account_number_ciphertext")
  accountNumberLast4      String    @map("account_number_last4")
  bankCode                String?   @map("bank_code")
  branchCode              String?   @map("branch_code")
  isPrimary               Boolean   @default(true) @map("is_primary")
  effectiveFrom           DateTime  @map("effective_from")
  effectiveUntil          DateTime? @map("effective_until")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdBy               String?   @map("created_by")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("employee_bank_accounts")
}

/// Append-only. Never updated — a new row is written for every transition.
model EmployeeStatusHistory {
  id             String   @id @default(uuid())
  companyId      String   @default("") @map("company_id")
  employeeId     String   @map("employee_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  effectiveDate  DateTime @map("effective_date")
  reason         String
  notes          String?
  approvedBy     String?  @map("approved_by")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("employee_status_history")
}

// ---------------------------------------------------------------------------
// Payroll — salary structures, monthly payroll runs, payslips, and the
// Singapore CPF contribution schedule (admin-editable master data since MOM/
// CPF Board rates change periodically). Statutory filing is a generated
// export file for manual submission to IRAS — no live IRAS/CPF API
// integration in this phase. See lib/services/payroll-service.ts.
// ---------------------------------------------------------------------------

model SalaryStructure {
  id                 String   @id @default(uuid())
  companyId          String   @default("") @map("company_id")
  employeeId         String   @unique @map("employee_id")
  basicMonthlySalary Decimal  @map("basic_monthly_salary") @db.Decimal(12, 2)
  effectiveFrom      DateTime @map("effective_from")
  cpfApplicable      Boolean  @default(true) @map("cpf_applicable")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String   @map("created_by")

  employee   Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components CompensationComponent[]
  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("salary_structures")
}

model CompensationComponent {
  id                String   @id @default(uuid())
  companyId         String   @default("") @map("company_id")
  salaryStructureId String   @map("salary_structure_id")
  type              String   @map("type") // ALLOWANCE | DEDUCTION | BONUS
  code              String
  label             String
  amount            Decimal  @db.Decimal(12, 2)
  isRecurring       Boolean  @default(true) @map("is_recurring")
  createdAt         DateTime @default(now()) @map("created_at")

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("compensation_components")
}

model PayrollPeriod {
  id                String    @id @default(uuid())
  companyId         String    @default("") @map("company_id")
  periodMonth       Int       @map("period_month")
  periodYear        Int       @map("period_year")
  status            String    @default("OPEN")
  cutoffDate        DateTime  @map("cutoff_date")
  payDate           DateTime? @map("pay_date")
  approvalRequestId String?   @map("approval_request_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String    @map("created_by")

  payslips Payslip[]
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, periodYear, periodMonth])
  @@map("payroll_periods")
}

model Payslip {
  id                  String   @id @default(uuid())
  companyId           String   @default("") @map("company_id")
  payrollPeriodId     String   @map("payroll_period_id")
  employeeId          String   @map("employee_id")
  basicPay            Decimal  @map("basic_pay") @db.Decimal(12, 2)
  totalAllowances     Decimal  @map("total_allowances") @db.Decimal(12, 2)
  totalDeductions     Decimal  @map("total_deductions") @db.Decimal(12, 2)
  grossPay            Decimal  @map("gross_pay") @db.Decimal(12, 2)
  employeeCpfAmount   Decimal  @map("employee_cpf_amount") @db.Decimal(12, 2)
  employerCpfAmount   Decimal  @map("employer_cpf_amount") @db.Decimal(12, 2)
  sdlAmount           Decimal  @map("sdl_amount") @db.Decimal(12, 2)
  netPay              Decimal  @map("net_pay") @db.Decimal(12, 2)
  // Nullable: Employee.userId is optional and not every employee has an
  // EmployeeBankAccount on file (e.g. a contractor mid-onboarding) — the
  // payslip row and its computed amounts still get created either way, with
  // disbursement left PENDING until a bank account is captured.
  paidToBankAccountId String?  @map("paid_to_bank_account_id")
  disbursementStatus  String   @default("PENDING") @map("disbursement_status")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  payrollPeriod PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee          @relation(fields: [employeeId], references: [id])
  lineItems     PayslipLineItem[]
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([payrollPeriodId, employeeId])
  @@map("payslips")
}

model PayslipLineItem {
  id        String  @id @default(uuid())
  companyId String  @default("") @map("company_id")
  payslipId String  @map("payslip_id")
  type      String // EARNING | DEDUCTION | EMPLOYER_CONTRIBUTION
  label     String
  amount    Decimal @db.Decimal(12, 2)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("payslip_line_items")
}

/// Admin-editable master data — Singapore CPF contribution rates by age
/// band. Seeded with a starter schedule (see prisma/seed.ts) that MUST be
/// verified against the current CPF Board rates before any real payroll run.
model CpfContributionRate {
  id            String    @id @default(uuid())
  companyId     String    @default("") @map("company_id")
  ageBandLabel  String    @map("age_band_label")
  minAge        Int       @map("min_age")
  maxAge        Int?      @map("max_age")
  wageCeiling   Decimal   @map("wage_ceiling") @db.Decimal(12, 2)
  employeeRate  Decimal   @map("employee_rate") @db.Decimal(5, 4)
  employerRate  Decimal   @map("employer_rate") @db.Decimal(5, 4)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("cpf_contribution_rates")
}

// ---------------------------------------------------------------------------
// Project Management — full lifecycle (Creation/Team/Phases/Inventory/Closure)
// and the 8-stage per-site execution workflow. Material/Equipment/Stock
// catalogs remain deliberately out of scope here — that is the later ERP
// phase's job; ProjectResourceRequest below is a lightweight request only.
// ---------------------------------------------------------------------------

model Project {
  id              String    @id @default(uuid())
  companyId       String    @default("") @map("company_id")
  code            String
  name            String
  clientName      String?   @map("client_name")
  description     String?
  address         String?
  estimatedBudget Decimal?  @map("estimated_budget") @db.Decimal(12, 2)
  status          String    @default("DRAFT")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  createdBy       String?   @map("created_by")
  closedAt        DateTime? @map("closed_at")
  closedBy        String?   @map("closed_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// Set only for projects created via lead-conversion-service.ts —
  /// manually-created projects (the existing createProject flow) leave
  /// these null, matching the client's "manual setup" requirement alongside
  /// the CRM-driven path.
  acquisitionPath              String?   @map("acquisition_path") // TENDER | NORMAL, denormalized from the source Lead
  sourceLeadId                 String?   @unique @map("source_lead_id")
  contractSignedAt             DateTime? @map("contract_signed_at")
  commencementDate             DateTime? @map("commencement_date")
  practicalCompletionDate      DateTime? @map("practical_completion_date")
  defectsLiabilityPeriodMonths Int?      @map("defects_liability_period_months")
  performanceBondAmount        Decimal?  @map("performance_bond_amount") @db.Decimal(12, 2)
  performanceBondExpiryDate    DateTime? @map("performance_bond_expiry_date")
  retentionPercentage          Decimal?  @map("retention_percentage") @db.Decimal(5, 2)

  sites               Site[]
  assignments         EmployeeProjectAssignment[]
  defaultForEmployees Employee[]                  @relation("EmployeeDefaultProject")
  resourceRequests    ProjectResourceRequest[]
  tasks               Task[]
  purchaseOrders      PurchaseOrder[]
  sourceLead          Lead?                       @relation(fields: [sourceLeadId], references: [id])
  budgetLines         ProjectBudgetLine[]
  documents           ProjectDocument[]
  progressClaims      ProgressClaim[]
  defects             DefectItem[]
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("projects")
}

model Site {
  id                        String   @id @default(uuid())
  companyId                 String   @default("") @map("company_id")
  projectId                 String   @map("project_id")
  code                      String
  name                      String
  isActive                  Boolean  @default(true) @map("is_active")
  currentStage              String   @default("PRE_START_PLANNING") @map("current_stage")
  currentStageStartedAt     DateTime @default(now()) @map("current_stage_started_at")
  handoverApprovalRequestId String?  @map("handover_approval_request_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  project             Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments         EmployeeProjectAssignment[]
  defaultForEmployees Employee[]                  @relation("EmployeeDefaultSite")
  attendanceRecords   AttendanceRecord[]
  stageHistory        SiteStageHistory[]
  resourceRequests    ProjectResourceRequest[]
  tasks               Task[]
  checklistItems      SiteStageChecklistItem[]
  defectItems         DefectItem[]
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@map("sites")
}

/// Per-site completion state of the fixed SOP checklist for the site's
/// *current* stage (SITE_STAGE_CHECKLISTS in lib/projects/constants.ts).
/// Rows only exist for items someone has checked — an unchecked item simply
/// has no row (see getChecklistForSite). itemIndex is only meaningful for
/// the stage it was written under; once a site advances past a stage, its
/// rows for that stage are left in place as a historical record but are no
/// longer editable (see SITE_STAGE_CHECKLIST_LOCKED).
model SiteStageChecklistItem {
  id        String    @id @default(uuid())
  companyId String    @default("") @map("company_id")
  siteId    String    @map("site_id")
  stage     String
  itemIndex Int       @map("item_index")
  isChecked Boolean   @default(false) @map("is_checked")
  checkedBy String?   @map("checked_by")
  checkedAt DateTime? @map("checked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([siteId, stage, itemIndex])
  @@map("site_stage_checklist_items")
}

/// Full audit/reporting trail of a site's 8-stage execution workflow.
/// `changedBy` is null for HANDOVER_APPROVED/REJECTED rows, which are
/// written from inside the generic approval engine's onApproved/onRejected
/// hook (only receives an ApprovalRequestSummary, no deciding-actor id) —
/// attribution for those two rows lives on the linked ApprovalStep instead.
model SiteStageHistory {
  id                String   @id @default(uuid())
  companyId         String   @default("") @map("company_id")
  siteId            String   @map("site_id")
  previousStage     String?  @map("previous_stage")
  newStage          String   @map("new_stage")
  trigger           String   @default("SELF_ADVANCE")
  notes             String?
  changedBy         String?  @map("changed_by")
  approvalRequestId String?  @map("approval_request_id")
  createdAt         DateTime @default(now()) @map("created_at")

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([siteId, createdAt])
  @@map("site_stage_history")
}

/// Lightweight equipment/material request tied to a project (and optionally
/// a site) — free text, no catalog. Routed through the generic Approval
/// Engine's EQUIPMENT_REQUEST module. Full stock/catalog/supplier tracking
/// is deliberately deferred to the later ERP phase.
model ProjectResourceRequest {
  id                     String    @id @default(uuid())
  companyId              String    @default("") @map("company_id")
  projectId              String    @map("project_id")
  siteId                 String?   @map("site_id")
  materialId             String?   @map("material_id")
  /// Denormalized snapshot of material.name at request time (display
  /// resilience if the catalog entry is later renamed/deactivated) — no
  /// longer user-typed free text; the service sets this from the resolved
  /// Material on create. Nullable materialId only exists for schema
  /// evolution safety; the create flow requires a real material.
  itemDescription        String    @map("item_description")
  quantity               Decimal   @db.Decimal(10, 2)
  unit                   String
  neededByDate           DateTime? @map("needed_by_date")
  notes                  String?
  status                 String    @default("PENDING")
  requestedByUserId      String    @map("requested_by_user_id")
  requestedByEmployeeId  String?   @map("requested_by_employee_id")
  /// Chosen at request-creation time, not at approval-decision time — the
  /// generic approval engine's decide step only ever carries
  /// {decision, notes} (see approval-service.ts), so any data the
  /// onApproved hook needs (which warehouse to issue from) must already be
  /// on the request row before it reaches approval.
  fulfillmentWarehouseId String?   @map("fulfillment_warehouse_id")
  approvalRequestId      String?   @map("approval_request_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site                 Site?      @relation(fields: [siteId], references: [id])
  material             Material?  @relation(fields: [materialId], references: [id])
  fulfillmentWarehouse Warehouse? @relation(fields: [fulfillmentWarehouseId], references: [id])
  company              Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@map("project_resource_requests")
}

/// Lightweight per-project work item, assigned to exactly one team member.
/// Deliberately simple (no subtasks, no reassignment, no checklist) — the
/// unit a Team Member's restricted project view is scoped around. Retired
/// via CANCELLED, never hard-deleted, matching the platform-wide convention.
model Task {
  id                   String    @id @default(uuid())
  companyId            String    @default("") @map("company_id")
  projectId            String    @map("project_id")
  siteId               String?   @map("site_id")
  title                String
  description          String?
  status               String    @default("TODO")
  assignedToEmployeeId String    @map("assigned_to_employee_id")
  dueDate              DateTime? @map("due_date")
  createdBy            String    @map("created_by")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  /// WBS extension — additive to the original flat/single-assignee design
  /// above (kept as-is: the restricted Team Member task view is scoped
  /// around exactly that shape). parentTaskId is null for top-level WBS
  /// nodes; a parent task can be a pure grouping node with no assignee-
  /// relevant status of its own, tracked instead via its subtasks' rollup.
  parentTaskId     String?   @map("parent_task_id")
  wbsCode          String?   @map("wbs_code") // display code, e.g. "1.2.3" — not enforced unique, purely presentational
  plannedStartDate DateTime? @map("planned_start_date")
  plannedEndDate   DateTime? @map("planned_end_date")
  percentComplete  Int       @default(0) @map("percent_complete")

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?    @relation(fields: [siteId], references: [id])
  assignee   Employee @relation("TaskAssignee", fields: [assignedToEmployeeId], references: [id])
  parentTask Task?    @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks   Task[]   @relation("TaskHierarchy")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([assignedToEmployeeId, status])
  @@index([parentTaskId])
  @@map("tasks")
}

model EmployeeProjectAssignment {
  id                   String    @id @default(uuid())
  companyId            String    @default("") @map("company_id")
  employeeId           String    @map("employee_id")
  projectId            String    @map("project_id")
  siteId               String?   @map("site_id")
  projectRoleId        String?   @map("project_role_id")
  allocationPercentage Int       @map("allocation_percentage")
  startDate            DateTime  @map("start_date")
  endDate              DateTime? @map("end_date")
  isPrimary            Boolean   @default(false) @map("is_primary")
  status               String    @default("PLANNED")
  assignedBy           String    @map("assigned_by")
  approvedBy           String?   @map("approved_by")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  employee    Employee     @relation("AssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id])
  site        Site?        @relation(fields: [siteId], references: [id])
  projectRole ProjectRole? @relation(fields: [projectRoleId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@map("employee_project_assignments")
}

/// HR-authorized manual override of the derived workforce-availability
/// status. Always reasoned and effective-dated; short-circuits derivation
/// only while current.
model EmployeeAvailabilityOverride {
  id             String    @id @default(uuid())
  companyId      String    @default("") @map("company_id")
  employeeId     String    @map("employee_id")
  status         String
  reason         String
  effectiveFrom  DateTime  @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("employee_availability_overrides")
}

// ---------------------------------------------------------------------------
// HRMS — Documents, work passes, certifications
// ---------------------------------------------------------------------------

model EmployeeDocument {
  id               String    @id @default(uuid())
  companyId        String    @default("") @map("company_id")
  employeeId       String    @map("employee_id")
  documentTypeId   String    @map("document_type_id")
  storageKey       String    @map("storage_key")
  originalFileName String    @map("original_file_name")
  mimeType         String    @map("mime_type")
  fileSizeBytes    Int       @map("file_size_bytes")
  checksum         String
  issueDate        DateTime? @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  documentNumber   String?   @map("document_number")
  issuingAuthority String?   @map("issuing_authority")
  isConfidential   Boolean   @default(false) @map("is_confidential")
  status           String    @default("UPLOADED")
  verifiedBy       String?   @map("verified_by")
  verifiedAt       DateTime? @map("verified_at")
  notes            String?
  revisionOfId     String?   @map("revision_of_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by")

  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType   DocumentType            @relation(fields: [documentTypeId], references: [id])
  revisionOf     EmployeeDocument?       @relation("DocumentRevision", fields: [revisionOfId], references: [id])
  revisions      EmployeeDocument[]      @relation("DocumentRevision")
  workPasses     WorkPass[]
  certifications EmployeeCertification[]
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_documents")
}

model WorkPass {
  id               String    @id @default(uuid())
  companyId        String    @default("") @map("company_id")
  employeeId       String    @map("employee_id")
  passType         String    @map("pass_type")
  passNumber       String    @map("pass_number")
  issuingCountry   String    @map("issuing_country")
  issuingAuthority String    @map("issuing_authority")
  issueDate        DateTime  @map("issue_date")
  expiryDate       DateTime  @map("expiry_date")
  status           String    @default("VALID")
  documentId       String?   @map("document_id")
  notes            String?
  verifiedBy       String?   @map("verified_by")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document EmployeeDocument? @relation(fields: [documentId], references: [id])
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("work_passes")
}

model EmployeeCertification {
  id               String    @id @default(uuid())
  companyId        String    @default("") @map("company_id")
  employeeId       String    @map("employee_id")
  typeId           String    @map("type_id")
  licenceNumber    String    @map("licence_number")
  issuingAuthority String    @map("issuing_authority")
  issueDate        DateTime  @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  status           String    @default("VALID")
  documentId       String?   @map("document_id")
  notes            String?
  verifiedBy       String?   @map("verified_by")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type     CertificationType @relation(fields: [typeId], references: [id])
  document EmployeeDocument? @relation(fields: [documentId], references: [id])
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_certifications")
}

// ---------------------------------------------------------------------------
// HRMS — Attendance
// ---------------------------------------------------------------------------

model ShiftType {
  id                 String   @id @default(uuid())
  companyId          String   @default("") @map("company_id")
  code               String
  name               String
  startTime          String   @map("start_time")
  endTime            String   @map("end_time")
  gracePeriodMinutes Int      @default(15) @map("grace_period_minutes")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employees         Employee[]         @relation("EmployeeDefaultShift")
  attendanceRecords AttendanceRecord[]
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("shift_types")
}

model Holiday {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  date        DateTime @db.Date
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, date])
  @@map("holidays")
}

/// One row per employee per calendar day. Absence for days with no row is
/// derived on read (see lib/services/attendance-service.ts), not stored —
/// mirrors the EmployeeAvailabilityOverride "derive, don't sweep" pattern.
model AttendanceRecord {
  id          String    @id @default(uuid())
  companyId   String    @default("") @map("company_id")
  employeeId  String    @map("employee_id")
  date        DateTime  @db.Date
  siteId      String?   @map("site_id")
  shiftTypeId String?   @map("shift_type_id")
  checkInAt   DateTime? @map("check_in_at")
  checkOutAt  DateTime? @map("check_out_at")
  status      String
  source      String    @default("SELF")
  notes       String?
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site      Site?      @relation(fields: [siteId], references: [id])
  shiftType ShiftType? @relation(fields: [shiftTypeId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([date, status])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// HRMS — Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id                     String   @id @default(uuid())
  companyId              String   @default("") @map("company_id")
  code                   String
  name                   String
  defaultEntitlementDays Decimal  @map("default_entitlement_days") @db.Decimal(5, 1)
  isPaid                 Boolean  @default(true) @map("is_paid")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests LeaveRequest[]
  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("leave_types")
}

/// Only the HR-adjustable inputs are stored; "used" is always computed live
/// by summing APPROVED LeaveRequest.dayCount for the type/year (same
/// "derive, don't duplicate" precedent as WorkforceAvailability/Attendance)
/// — avoids the stored-used-count ever drifting from actual approved requests.
model LeaveBalance {
  id                 String   @id @default(uuid())
  companyId          String   @default("") @map("company_id")
  employeeId         String   @map("employee_id")
  leaveTypeId        String   @map("leave_type_id")
  year               Int
  entitledDays       Decimal  @map("entitled_days") @db.Decimal(5, 1)
  carriedForwardDays Decimal  @default(0) @map("carried_forward_days") @db.Decimal(5, 1)
  updatedBy          String?  @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                String   @id @default(uuid())
  companyId         String   @default("") @map("company_id")
  employeeId        String   @map("employee_id")
  leaveTypeId       String   @map("leave_type_id")
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  startHalfDay      Boolean  @default(false) @map("start_half_day")
  endHalfDay        Boolean  @default(false) @map("end_half_day")
  dayCount          Decimal  @map("day_count") @db.Decimal(5, 1)
  reason            String?
  status            String   @default("PENDING")
  approvalRequestId String?  @unique @map("approval_request_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Approvals — generic, module-agnostic approval-request engine
// ---------------------------------------------------------------------------

/// Entity-agnostic approval request, reused by every module that needs a
/// request -> approve/reject flow (Leave, Equipment/Material requests,
/// Project stage-gates, Purchase requests, ...) instead of each module
/// building its own. `module`/`entityType`/`entityId` identify what's being
/// approved (FK-by-convention, mirrors AuditLog.entityId — no direct Prisma
/// relation since the target model varies per module); `payload` carries a
/// module-specific snapshot used by the module's registered handler
/// (see lib/services/approval-registry.ts) to resolve approvers and act on
/// the decision. See lib/services/approval-service.ts for the full contract.
model ApprovalRequest {
  id                    String   @id @default(uuid())
  companyId             String   @default("") @map("company_id")
  module                String // e.g. "LEAVE" | "EQUIPMENT_REQUEST" | "PROJECT_STAGE_GATE"
  entityType            String   @map("entity_type") // e.g. "LeaveRequest"
  entityId              String   @map("entity_id")
  requestedBy           String   @map("requested_by") // User.id
  requestedByEmployeeId String?  @map("requested_by_employee_id")
  status                String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  currentStepOrder      Int      @default(1) @map("current_step_order")
  payload               Json
  reason                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  version               Int      @default(1)

  steps   ApprovalStep[]
  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([module, entityType, entityId])
  @@index([status])
  @@index([requestedBy])
  @@map("approval_requests")
}

/// One row per decision step in an ApprovalRequest's chain. Most consumers
/// today only need a single step, but this stays a child table (rather than
/// flattening approver/decision fields onto ApprovalRequest) so a future
/// dual-sign-off requirement (e.g. high-value purchase approvals) doesn't
/// require redesigning the table under live data.
model ApprovalStep {
  id                String    @id @default(uuid())
  companyId         String    @default("") @map("company_id")
  approvalRequestId String    @map("approval_request_id")
  stepOrder         Int       @map("step_order")
  approverUserId    String?   @map("approver_user_id") // resolved specific approver, if known
  approverRole      String?   @map("approver_role") // OR a role-pool ("ADMIN"), resolved at decide-time
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  decisionNotes     String?   @map("decision_notes")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([approvalRequestId, stepOrder])
  @@index([approverUserId, status])
  @@map("approval_steps")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// Minimal in-app notification, delivered today only by the approval engine
/// (see approval-service.ts's decideApprovalStep -> notifyUsers). Email
/// delivery is deferred behind a pluggable channel interface — this table
/// is the in-app channel only.
model Notification {
  id         String    @id @default(uuid())
  companyId  String    @default("") @map("company_id")
  userId     String    @map("user_id")
  type       String // e.g. "APPROVAL_DECIDED"
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// CRM — Lead-to-Delivery pipeline. A Lead is pre-project: client
// negotiation, tender bidding, or quotation pricing happens here, entirely
// separate from Project (which only exists once work is actually won and
// commissioned) — this keeps CRM-only data (competing-bid notes, pricing
// strategy) out of PROJECTS.VIEW-scoped queries that Managers/Team Members
// can already read. Two acquisition paths:
//   TENDER — public-sector (HDB/Town Council) tenders: formal BOQ pricing,
//     tender/bid bond, Price-Quality Method evaluation, Letter of Award.
//   NORMAL — direct/negotiated private work (MCST/building owner): a
//     Quotation, negotiation, private Letter of Award.
// A WON Lead converts into a Project via lead-conversion-service.ts — the
// FK lives on Project (sourceLeadId), not Lead, so "has this lead been
// converted" is a cheap back-relation lookup, not a second denormalized flag.
// ---------------------------------------------------------------------------

model Lead {
  id                String   @id @default(uuid())
  companyId         String   @default("") @map("company_id")
  code              String
  clientName        String   @map("client_name")
  contactPersonName String?  @map("contact_person_name")
  contactPhone      String?  @map("contact_phone")
  contactEmail      String?  @map("contact_email")
  source            String? // REFERRAL | WEBSITE | TENDER_BOARD | COLD_OUTREACH | REPEAT_CLIENT | OTHER
  acquisitionPath   String   @map("acquisition_path") // TENDER | NORMAL — fixed at creation, decides whether a Tender or Quotation applies
  status            String   @default("NEW") // NEW | QUALIFIED | IN_PROGRESS | NEGOTIATION | WON | LOST | CONVERTED
  estimatedValue    Decimal? @map("estimated_value") @db.Decimal(12, 2)
  ownerUserId       String   @map("owner_user_id")
  lostReason        String?  @map("lost_reason")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tender           Tender?
  quotations       Quotation[]
  documents        ProjectDocument[]
  convertedProject Project?
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("leads")
}

/// Public-sector (HDB/Town Council) tender lifecycle. Status is an ordered
/// checklist (TENDER_STATUS_ORDER in lib/crm/constants.ts) rather than a
/// strict single-step chain — optional stages (site visit, query) can be
/// skipped forward over, but AWARDED/NOT_AWARDED can never be reached
/// without having passed through SUBMITTED first (enforced in
/// tender-service.ts, not just the client).
model Tender {
  id                         String    @id @default(uuid())
  companyId                  String    @default("") @map("company_id")
  leadId                     String    @unique @map("lead_id")
  tenderReferenceNo          String?   @map("tender_reference_no")
  issuingBody                String?   @map("issuing_body") // e.g. "HDB", "Tampines Town Council"
  status                     String    @default("DOCUMENT_COLLECTION")
  noticeDate                 DateTime? @map("notice_date")
  documentCollectionDeadline DateTime? @map("document_collection_deadline")
  siteVisitMandatory         Boolean   @default(false) @map("site_visit_mandatory")
  siteVisitDate              DateTime? @map("site_visit_date")
  queryDeadline              DateTime? @map("query_deadline")
  submissionDeadline         DateTime? @map("submission_deadline")
  tenderBondAmount           Decimal?  @map("tender_bond_amount") @db.Decimal(12, 2)
  evaluationMethod           String?   @map("evaluation_method") // LOWEST_PRICE | PRICE_QUALITY_METHOD
  boqTotal                   Decimal?  @map("boq_total") @db.Decimal(14, 2)
  bidAmount                  Decimal?  @map("bid_amount") @db.Decimal(14, 2)
  submittedAt                DateTime? @map("submitted_at")
  openedAt                   DateTime? @map("opened_at")
  awardedAt                  DateTime? @map("awarded_at")
  outcomeNotes               String?   @map("outcome_notes")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  lead    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lines   PricingLine[]
  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("tenders")
}

/// Private/negotiated quotation lifecycle (the NORMAL acquisition path).
/// Versioned (a re-priced quotation bumps `version` rather than mutating a
/// sent one, matching the immutable-ledger convention used elsewhere).
model Quotation {
  id          String    @id @default(uuid())
  companyId   String    @default("") @map("company_id")
  leadId      String    @map("lead_id")
  version     Int       @default(1)
  status      String    @default("DRAFT") // DRAFT | SENT | NEGOTIATING | ACCEPTED | REJECTED | EXPIRED
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  validUntil  DateTime? @map("valid_until")
  notes       String?
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lead    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lines   PricingLine[]
  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("quotations")
}

/// Shared BOQ/quotation line-item shape — exactly one of tenderId/quotationId
/// is set (enforced in the service layer; Prisma has no portable CHECK
/// constraint for "exactly one of two nullable FKs"). `amount` is stored,
/// not computed from quantity*unitRate, for audit stability if unitRate is
/// later corrected — matches ProjectResourceRequest.itemDescription's
/// "denormalized snapshot" reasoning.
model PricingLine {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  tenderId    String?  @map("tender_id")
  quotationId String?  @map("quotation_id")
  itemNo      String   @map("item_no")
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12, 2)
  unitRate    Decimal  @map("unit_rate") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  tender    Tender?    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("pricing_lines")
}

/// Structural replica of EmployeeDocument, shared by the pre-project CRM
/// stage (leadId) and the post-conversion Project (projectId) — exactly one
/// of the two is set at any time; lead-conversion-service.ts flips a
/// document from leadId to projectId at conversion, no copy/duplication.
model ProjectDocument {
  id               String   @id @default(uuid())
  companyId        String   @default("") @map("company_id")
  projectId        String?  @map("project_id")
  leadId           String?  @map("lead_id")
  documentTypeId   String   @map("document_type_id")
  storageKey       String   @map("storage_key")
  originalFileName String   @map("original_file_name")
  mimeType         String   @map("mime_type")
  fileSizeBytes    Int      @map("file_size_bytes")
  checksum         String
  status           String   @default("UPLOADED")
  revisionOfId     String?  @map("revision_of_id")
  isConfidential   Boolean  @default(false) @map("is_confidential")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  documentType DocumentType      @relation(fields: [documentTypeId], references: [id])
  revisionOf   ProjectDocument?  @relation("DocRevision", fields: [revisionOfId], references: [id])
  revisions    ProjectDocument[] @relation("DocRevision")
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("project_documents")
}

/// Budget-vs-committed-vs-actual per cost category — a lightweight EVM
/// foundation. `committedAmount` is expected to be rolled up from approved
/// PurchaseOrders raised against this project (see PurchaseOrder.projectId)
/// once that linkage is populated; not automatically maintained by a
/// trigger, updated explicitly by the service layer on PO approval.
model ProjectBudgetLine {
  id              String   @id @default(uuid())
  companyId       String   @default("") @map("company_id")
  projectId       String   @map("project_id")
  category        String // LABOUR | MATERIAL | EQUIPMENT | SUBCONTRACT | OVERHEAD
  description     String?
  budgetedAmount  Decimal  @map("budgeted_amount") @db.Decimal(12, 2)
  committedAmount Decimal  @default(0) @map("committed_amount") @db.Decimal(12, 2)
  actualAmount    Decimal  @default(0) @map("actual_amount") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("project_budget_lines")
}

/// Monthly interim payment claim — the standard Singapore-contract
/// mechanism (PSSCOC/SIA-style conditions): contractor submits a claim, a
/// certifier (Admin/Super Admin, standing in for the contract's
/// Superintending Officer) signs off a certified amount, retention is held
/// back from the certified sum. Certification is approval-gated via the
/// generic engine (PROGRESS_CLAIM module), same shape as PAYROLL_RUN.
model ProgressClaim {
  id                  String    @id @default(uuid())
  companyId           String    @default("") @map("company_id")
  projectId           String    @map("project_id")
  claimNumber         Int       @map("claim_number")
  claimPeriodTo       DateTime  @map("claim_period_to")
  claimedAmount       Decimal   @map("claimed_amount") @db.Decimal(12, 2)
  certifiedAmount     Decimal?  @map("certified_amount") @db.Decimal(12, 2)
  retentionPercentage Decimal   @default(5) @map("retention_percentage") @db.Decimal(5, 2)
  retentionHeld       Decimal?  @map("retention_held") @db.Decimal(12, 2)
  status              String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | CERTIFIED | REJECTED | PAID
  approvalRequestId   String?   @map("approval_request_id")
  submittedBy         String?   @map("submitted_by")
  submittedAt         DateTime? @map("submitted_at")
  paidAt              DateTime? @map("paid_at")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([projectId, claimNumber])
  @@map("progress_claims")
}

/// Defect logged during the post-handover Defects Liability Period (DLP) —
/// see Project.defectsLiabilityPeriodMonths. Deliberately lightweight (no
/// approval workflow — a defect is a fact reported and later fixed, not a
/// request needing sign-off) but still per-site so it plugs into existing
/// site-scoped views.
model DefectItem {
  id          String    @id @default(uuid())
  companyId   String    @default("") @map("company_id")
  projectId   String    @map("project_id")
  siteId      String?   @map("site_id")
  description String
  reportedBy  String?   @map("reported_by")
  reportedAt  DateTime  @default(now()) @map("reported_at")
  dueDate     DateTime? @map("due_date")
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | RECTIFIED | DISPUTED | CLOSED
  rectifiedAt DateTime? @map("rectified_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id])
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("defect_items")
}

// ---------------------------------------------------------------------------
// ERP — Material/Equipment catalog, Suppliers, Warehouses, Stock (now
// warehouse-scoped — the original central-pool-only decision was reversed;
// see Warehouse below), Purchase Orders, Goods Receipt, Stock Transfers.
// ---------------------------------------------------------------------------

model MaterialCategory {
  id          String   @id @default(uuid())
  companyId   String   @default("") @map("company_id")
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials Material[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("material_categories")
}

/// Unified catalog for materials, equipment, and services — one model
/// rather than near-duplicate Material/Equipment tables, distinguished by
/// `type`. `referenceCost` is a default/last-known unit cost used for
/// budgeting and quotations, not an authoritative price list.
model Material {
  id            String   @id @default(uuid())
  companyId     String   @default("") @map("company_id")
  code          String
  name          String
  type          String   @default("MATERIAL") // MATERIAL | EQUIPMENT | SERVICE
  categoryId    String?  @map("category_id")
  unit          String
  referenceCost Decimal? @map("reference_cost") @db.Decimal(12, 2)
  reorderLevel  Decimal? @map("reorder_level") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category           MaterialCategory?        @relation(fields: [categoryId], references: [id])
  stockLevels        StockLevel[]
  stockTransactions  StockTransaction[]
  resourceRequests   ProjectResourceRequest[]
  purchaseOrderLines PurchaseOrderLine[]
  stockTransfers     StockTransfer[]
  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("materials")
}

model Supplier {
  id                String   @id @default(uuid())
  companyId         String   @default("") @map("company_id")
  code              String
  name              String
  contactPersonName String?  @map("contact_person_name")
  phone             String?
  email             String?
  address           String?
  notes             String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  documents      SupplierDocument[]
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("suppliers")
}

/// Physical stock location. Introduced when the central-pool-only decision
/// (see the module header comment above) was reversed to support real
/// multi-site material staging — every StockLevel/StockTransaction row now
/// carries a warehouseId. `managedByEmployeeId` is the natural hook for the
/// WAREHOUSE_KEEPER role (lib/authorization/roles.ts) though a warehouse can
/// exist unmanaged (e.g. during initial setup).
model Warehouse {
  id                  String   @id @default(uuid())
  companyId           String   @default("") @map("company_id")
  code                String
  name                String
  address             String?
  isActive            Boolean  @default(true) @map("is_active")
  managedByEmployeeId String?  @map("managed_by_employee_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  managedByEmployee Employee?                @relation("WarehouseManager", fields: [managedByEmployeeId], references: [id])
  stockLevels       StockLevel[]
  stockTransactions StockTransaction[]
  purchaseOrders    PurchaseOrder[]
  resourceRequests  ProjectResourceRequest[]
  transfersOut      StockTransfer[]          @relation("TransferFrom")
  transfersIn       StockTransfer[]          @relation("TransferTo")
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("warehouses")
}

/// One running balance per material *per warehouse* — reversed from the
/// original central-pool-only decision (see module header). Maintained
/// transactionally alongside each StockTransaction insert; StockTransaction
/// is the source of truth, this is a derived-but-stored total for cheap
/// reads.
model StockLevel {
  id             String   @id @default(uuid())
  companyId      String   @default("") @map("company_id")
  materialId     String   @map("material_id")
  warehouseId    String   @map("warehouse_id")
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  material  Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([materialId, warehouseId])
  @@map("stock_levels")
}

/// Immutable stock movement ledger — never updated or deleted, matching the
/// SiteStageHistory precedent (audit trail, not just current-state). Allowed
/// to take StockLevel negative (backorder) per the locked decision — never
/// blocked at the transaction layer. `createdBy` is null for engine-driven
/// rows (e.g. an EQUIPMENT_REQUEST approval issuing stock) — same reasoning
/// as SiteStageHistory.changedBy: the approval-registry onApproved hook only
/// receives an ApprovalRequestSummary, no deciding-actor id; attribution for
/// those rows lives on the linked ApprovalStep instead.
model StockTransaction {
  id            String   @id @default(uuid())
  companyId     String   @default("") @map("company_id")
  materialId    String   @map("material_id")
  warehouseId   String   @map("warehouse_id")
  type          String // RECEIPT | ISSUE | ADJUSTMENT
  quantity      Decimal  @db.Decimal(14, 2)
  referenceType String?  @map("reference_type") // PURCHASE_ORDER | PROJECT_RESOURCE_REQUEST | STOCK_TRANSFER | MANUAL
  referenceId   String?  @map("reference_id")
  notes         String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  material  Material  @relation(fields: [materialId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([materialId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("stock_transactions")
}

/// Purchase order raised against a Supplier for delivery into a specific
/// Warehouse. `projectId` is an optional traceability link ("this PO was
/// raised to restock for project X") — not a hard fulfillment link; a PO
/// generally restocks the warehouse in general, not one earmarked request.
model PurchaseOrder {
  id                   String    @id @default(uuid())
  companyId            String    @default("") @map("company_id")
  poNumber             String    @map("po_number")
  supplierId           String    @map("supplier_id")
  warehouseId          String    @map("warehouse_id")
  projectId            String?   @map("project_id")
  status               String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  approvalRequestId    String?   @map("approval_request_id")
  notes                String?
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  project       Project?            @relation(fields: [projectId], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  documents     SupplierDocument[]
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  companyId        String  @default("") @map("company_id")
  purchaseOrderId  String  @map("purchase_order_id")
  materialId       String  @map("material_id")
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(12, 2)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(12, 2)
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material          Material           @relation(fields: [materialId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("purchase_order_lines")
}

/// One goods-receipt event against a PurchaseOrder — a PO can be received
/// across several partial receipts. Posting a receipt writes StockTransaction
/// rows via the existing writeStockTransaction (see lib/services/stock-service.ts)
/// and rolls PurchaseOrderLine.quantityReceived / the parent PO's status.
model GoodsReceipt {
  id              String   @id @default(uuid())
  companyId       String   @default("") @map("company_id")
  purchaseOrderId String   @map("purchase_order_id")
  receivedBy      String   @map("received_by")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceiptLine[]
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid())
  companyId           String  @default("") @map("company_id")
  goodsReceiptId      String  @map("goods_receipt_id")
  purchaseOrderLineId String  @map("purchase_order_line_id")
  quantityReceived    Decimal @map("quantity_received") @db.Decimal(12, 2)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_lines")
}

/// Structural replica of EmployeeDocument, scoped to Supplier and/or
/// PurchaseOrder (either FK may be set independently — e.g. a supplier's
/// standing contract vs. a one-off PO delivery order).
model SupplierDocument {
  id               String   @id @default(uuid())
  companyId        String   @default("") @map("company_id")
  supplierId       String?  @map("supplier_id")
  purchaseOrderId  String?  @map("purchase_order_id")
  documentTypeId   String   @map("document_type_id")
  storageKey       String   @map("storage_key")
  originalFileName String   @map("original_file_name")
  mimeType         String   @map("mime_type")
  fileSizeBytes    Int      @map("file_size_bytes")
  checksum         String
  status           String   @default("UPLOADED")
  isConfidential   Boolean  @default(false) @map("is_confidential")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  documentType  DocumentType   @relation(fields: [documentTypeId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("supplier_documents")
}

/// Transfer of stock between two warehouses, modeled as two distinct stock
/// writes rather than one atomic move: an ISSUE from the source warehouse
/// at dispatch (IN_TRANSIT), and a RECEIPT at the destination only once
/// someone (typically the destination's WAREHOUSE_KEEPER) confirms physical
/// receipt — this matches the real-world goods-in-transit gap and gives the
/// receiving warehouse keeper an actual confirmation step rather than
/// treating a transfer as instantaneous.
model StockTransfer {
  id              String    @id @default(uuid())
  companyId       String    @default("") @map("company_id")
  materialId      String    @map("material_id")
  fromWarehouseId String    @map("from_warehouse_id")
  toWarehouseId   String    @map("to_warehouse_id")
  quantity        Decimal   @db.Decimal(14, 2)
  status          String    @default("PENDING") // PENDING | IN_TRANSIT | RECEIVED | CANCELLED
  requestedBy     String    @map("requested_by")
  dispatchedAt    DateTime? @map("dispatched_at")
  receivedBy      String?   @map("received_by")
  receivedAt      DateTime? @map("received_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  material      Material  @relation(fields: [materialId], references: [id])
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("stock_transfers")
}
